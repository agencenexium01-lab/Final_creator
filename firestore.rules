rules_version = '2';

// Modèle de données
// users/{uid}             profil + solde. Les champs de crédits ne sont écrits QUE par le serveur.
// generations/{id}        historique, écrit par le serveur (api/generate.ts), lisible par son auteur.
// processed_sales/{id}    ventes Chariow déjà créditées (serveur uniquement).
// unmatched_sales/{id}    ventes sans compte correspondant (serveur uniquement).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Champs que l'utilisateur peut modifier lui-même.
    function editableKeys() {
      return ['name', 'niche', 'platform', 'country', 'onboarding_completed'];
    }

    function validEditable(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 50
        && (!('niche' in d) || (d.niche is string && d.niche.size() <= 80))
        && d.platform in ['tiktok', 'facebook', 'both']
        && (!('country' in d) || (d.country is string && d.country.matches('^[A-Z]{2}$')))
        && d.onboarding_completed is bool;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // Création du profil à l'inscription : solde à zéro, rien d'acheté.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['id', 'email', 'created_at', 'credits', 'totalCreditsUsed',
             'totalCreditsPurchased', 'lastPurchaseDate', 'lastPurchasePack'].concat(editableKeys()))
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.credits == 0
        && request.resource.data.totalCreditsUsed == 0
        && request.resource.data.totalCreditsPurchased == 0
        && request.resource.data.lastPurchaseDate == ''
        && request.resource.data.lastPurchasePack == ''
        && request.resource.data.created_at is string
        && validEditable(request.resource.data);

      // Mise à jour : uniquement les champs de profil, jamais les crédits.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableKeys())
        && validEditable(request.resource.data);

      allow delete: if false;
    }

    match /generations/{id} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create, update: if false;
    }

    // Tout le reste est réservé au serveur (SDK Admin, qui ignore ces règles).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
