# ------------------------------------------------------------------
# Variables PUBLIQUES (préfixe VITE_) : visibles dans le navigateur.
# Firebase > Paramètres du projet > Vos applications > Configuration.
# ------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Base Firestore nommée (ex. ai-studio-...). Vide = base par défaut.
VITE_FIREBASE_DATABASE_ID=

# ------------------------------------------------------------------
# Variables SECRÈTES (serveur uniquement, jamais de préfixe VITE_).
# À définir dans Vercel > Settings > Environment Variables.
# ------------------------------------------------------------------
# URL publique du site (redirection après paiement)
APP_URL=https://creator-booster.vercel.app

# Firebase Admin : Firebase > Paramètres > Comptes de service > Générer une clé privée
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Coller la clé sur une ligne, avec les \n
FIREBASE_PRIVATE_KEY=
# Même valeur que VITE_FIREBASE_DATABASE_ID
FIREBASE_DATABASE_ID=

# Google Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Chariow : Paramètres > API, et Automatisations > Pulses (secret whsec_...)
CHARIOW_API_KEY=
CHARIOW_PULSE_SECRET=
CHARIOW_PRODUCT_STARTER=
CHARIOW_PRODUCT_CREATEUR=
CHARIOW_PRODUCT_PRO=
